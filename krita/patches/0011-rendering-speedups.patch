+/*
+ *  ps_tools patch: switches and counters of the Photoshop-like rendering
+ *  speed-ups (see kis_async_merger.cpp and kis_simple_update_queue.cpp).
+ *
+ *  The ps_tools plugin switches them with the application property
+ *  "ps_tools_perf" (the psfilters plugin passes it on), so a speed-up that
+ *  misbehaves can be turned off without a new build. Tests compare the
+ *  rendering with and without them.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef KIS_PS_PERF_H
+#define KIS_PS_PERF_H
+
+#include "kritaimage_export.h"
+
+#include <QString>
+
+namespace psPerf {
+
+enum Flag {
+    /// While one layer is painted / changed, what lies below it on its level
+    /// is kept composited (like Photoshop) instead of being composited again
+    /// for every dab.
+    BelowCache = 0x1,
+    /// The Normal-mode layers at the top of that level are kept merged into
+    /// one (Normal "over" is associative).
+    AboveCache = 0x2,
+    /// Updates of the part of the image visible on the canvas go first.
+    ViewportFirst = 0x4,
+    /// Clipping stacks reuse their buffers.
+    PooledStacks = 0x8,
+
+    AllFlags = 0xf
+};
+
+KRITAIMAGE_EXPORT int flags();
+KRITAIMAGE_EXPORT void setFlags(int flags);
+inline bool on(Flag f) { return flags() & f; }
+
+/// Counters for tests: "belowHit=.. belowFill=.. aboveHit=.. ..."
+KRITAIMAGE_EXPORT QString stats();
+KRITAIMAGE_EXPORT void resetStats();
+/// Drops every cached composite (tests; also when the flags change).
+KRITAIMAGE_EXPORT void dropCaches();
+
+}
+
+#endif
