+/*********************************************************************/
+/*        Photoshop-like composite caches (ps_tools patch)           */
+/*********************************************************************/
+
+/**
+ * While one layer (the "pivot") is painted or changed, every update starts
+ * at that layer and, on the pivot's level, composites again all the layers
+ * below it and all the layers above it. Photoshop keeps the composite of
+ * what is below the layer (and of what is above it) instead. Here:
+ *
+ *  - below cache: the state of the level's projection right before the
+ *    pivot is composited, saved per pixel the first time an area is
+ *    rendered and copied back on the next updates of that area. The
+ *    layers below the pivot are then not touched at all.
+ *  - above cache: the topmost layers of the level, when all are plain
+ *    Normal layers (no adjustment, Blend If, clipping, style, channel
+ *    flags), merged into one device: Normal "over" is associative, so
+ *    "M over X" equals compositing them one by one (up to rounding).
+ *
+ * Every level on the way from the painted layer to the root has its own
+ * pivot (the group holding the layer is the pivot of the group's level),
+ * so nested groups are cached too.
+ *
+ * Validity: a cache entry only holds layers other than its pivot and the
+ * pivot's subtree. Any update starting elsewhere in the same image drops
+ * the entry (a changed layer, a moved layer, a property change, a full
+ * refresh...). An entry also remembers the graph sequence number and the
+ * pivot's clipping switch. The cache is used only when every rect of the
+ * update is the same (no blur-like layer above needs a bigger area).
+ */
+struct PsCacheEntry {
+    KisNodeWSP pivot;
+    const KisNode *level = nullptr;      // the projection parent (identity)
+    const KisNode *root = nullptr;       // the image (identity)
+    int lod = 0;
+    int graphSeq = 0;
+    bool pivotClip = false;
+    const KoColorSpace *colorSpace = nullptr;
+
+    KisPaintDeviceSP below;
+    QRegion belowValid;
+
+    QVector<const KisNode*> run;         // above run, bottom to top
+    KisPaintDeviceSP above;
+    QRegion aboveValid;
+
+    quint64 lastUse = 0;
+    bool alive = true;
+};
+typedef QSharedPointer<PsCacheEntry> PsCacheEntrySP;
+
+struct PsCacheStats {
+    std::atomic<int> belowHit {0}, belowFill {0}, aboveHit {0}, aboveFill {0};
+    std::atomic<int> dropped {0}, skippedVaries {0}, inconsistent {0};
+};
+
+class PsCacheStore
+{
+public:
+    static PsCacheStore *instance() {
+        static PsCacheStore *store = new PsCacheStore();     // never freed
+        return store;
+    }
+
+    static const int MaxEntries = 6;
+
+    QMutex lock;
+    QVector<PsCacheEntrySP> entries;
+    quint64 clock = 0;
+    PsCacheStats stats;
+
+    void killLocked(int i) {
+        entries[i]->alive = false;
+        entries.removeAt(i);
+        stats.dropped++;
+    }
+
+    void dropAll() {
+        QMutexLocker l(&lock);
+        while (!entries.isEmpty()) killLocked(entries.size() - 1);
+    }
+};
+
+std::atomic<int> s_psPerfFlags {psPerf::AllFlags};
+
+const KisNode *rootOf(const KisNode *node)
+{
+    while (node && node->parent()) node = node->parent().data();
+    return node;
+}
+
+bool isSelfOrDescendant(const KisNode *node, const KisNode *ancestor)
+{
+    for (; node; node = node->parent().data()) {
+        if (node == ancestor) return true;
+    }
+    return false;
+}
+
+/// At the start of every merge: drop the entries this update may change.
+void psCacheOnMergeStart(KisBaseRectsWalker &walker)
+{
+    PsCacheStore *store = PsCacheStore::instance();
+    KisNodeSP start = walker.startNode();
+    const bool update = walker.type() == KisBaseRectsWalker::UPDATE ||
+                        walker.type() == KisBaseRectsWalker::UPDATE_NO_FILTHY;
+    const KisNode *root = rootOf(start.data());
+
+    QMutexLocker l(&store->lock);
+    for (int i = store->entries.size() - 1; i >= 0; i--) {
+        PsCacheEntrySP e = store->entries[i];
+        KisNodeSP pivot = e->pivot;
+        if (!pivot) {
+            store->killLocked(i);
+            continue;
+        }
+        if (e->root != root && rootOf(pivot.data()) != root) continue;   // another image
+        if (update && start && isSelfOrDescendant(start.data(), pivot.data())) continue;
+        store->killLocked(i);
+    }
+}
+
+/// A layer that can be merged with the layers above it into the above cache.
+bool psRunEligible(KisProjectionLeafSP leaf, const KisNode *level)
+{
+    KisNodeSP node = leaf->node();
+    if (!node || node->parent().data() != level) return false;      // flattened pass-through child
+    if (!leaf->isLayer() || leaf->dependsOnLowerNodes()) return false;
+    KisLayer *layer = qobject_cast<KisLayer*>(node.data());
+    if (!layer) return false;
+    KisGroupLayer *group = qobject_cast<KisGroupLayer*>(node.data());
+    if (group && group->effectivePassThroughMode()) return false;
+    if (psClip::clipFlag(node.data())) return false;
+    if (node->compositeOpId() != COMPOSITE_OVER) return false;
+    if (layer->layerStyle()) return false;
+    psBlendIf::Settings blendIf;
+    if (psBlendIf::findSettings(node.data(), blendIf)) return false;
+    const QBitArray flags = leaf->channelFlags();
+    if (!flags.isEmpty() && flags.count(true) != flags.size()) return false;
+    return true;
+}
+
+struct PsLevelPlan {
+    enum Mode { None, Fill, Hit };
+
+    const KisNode *level = nullptr;
+    int begin = -1, end = -1;            // pop-order indexes, inclusive
+    int pivot = -1;
+    QRect rect;
+    PsCacheEntrySP entry;
+    Mode below = None;
+    int runStart = -1;
+    Mode above = None;
+    KisPaintDeviceSP belowDevice;        // for a hit, read under the lock
+    KisPaintDeviceSP aboveDevice;
+};
+
+struct PsMergePlan {
+    QVector<int> levelOf;                // pop index -> level plan index or -1
+    QVector<PsLevelPlan> levels;
+
+    PsLevelPlan *at(int popIndex) {
+        if (popIndex < 0 || popIndex >= levelOf.size()) return nullptr;
+        const int l = levelOf[popIndex];
+        return l >= 0 ? &levels[l] : nullptr;
+    }
+};
+
+/// Decides, per level of this merge, whether the caches are filled or used.
+PsMergePlan psCachePlan(KisBaseRectsWalker &walker)
+{
+    PsMergePlan plan;
+    const int flags = psPerf::flags();
+    if (!(flags & (psPerf::BelowCache | psPerf::AboveCache))) return plan;
+    if (walker.type() != KisBaseRectsWalker::UPDATE) return plan;
+
+    PsCacheStore *store = PsCacheStore::instance();
+    if (walker.needRectVaries()) {
+        store->stats.skippedVaries++;
+        return plan;
+    }
+
+    const KisMergeWalker::LeafStack &stack = walker.leafStack();
+    const int n = stack.size();
+    QVector<KisMergeWalker::JobItem> items(n);
+    for (int i = 0; i < n; i++) items[i] = stack[n - 1 - i];       // pop order
+    plan.levelOf.fill(-1, n);
+
+    // levels: runs of ordinary items ending with the topmost one
+    int begin = -1;
+    for (int i = 0; i < n; i++) {
+        const KisMergeWalker::JobItem &it = items[i];
+        if (it.m_leaf->isRoot() || (it.m_position & KisMergeWalker::N_EXTRA)) {
+            begin = -1;
+            continue;
+        }
+        if (begin < 0) begin = i;
+        if ((it.m_position & KisMergeWalker::N_TOPMOST) || i == n - 1) {
+            PsLevelPlan lvl;
+            lvl.begin = begin;
+            lvl.end = i;
+            plan.levels.append(lvl);
+            begin = -1;
+        }
+    }
+
+    const KisNode *root = rootOf(walker.startNode().data());
+    const int lod = walker.levelOfDetail();
+
+    for (int li = 0; li < plan.levels.size(); li++) {
+        PsLevelPlan &lvl = plan.levels[li];
+        const KisMergeWalker::JobItem &first = items[lvl.begin];
+        KisProjectionLeafSP parentLeaf = first.m_leaf->parent();
+        if (!parentLeaf || !parentLeaf->node()) continue;
+        lvl.level = parentLeaf->node().data();
+        lvl.rect = first.m_applyRect;
+
+        bool uniform = true;
+        for (int i = lvl.begin; i <= lvl.end; i++) {
+            const KisMergeWalker::JobItem &it = items[i];
+            if (it.m_applyRect != lvl.rect) uniform = false;
+            if (it.m_position & (KisMergeWalker::N_FILTHY | KisMergeWalker::N_FILTHY_PROJECTION)) {
+                if (lvl.pivot >= 0) uniform = false;                // two pivots: leave it
+                lvl.pivot = i;
+            }
+        }
+        if (!uniform || lvl.pivot < 0 || lvl.rect.isEmpty()) continue;
+
+        KisNodeSP pivotNode = items[lvl.pivot].m_leaf->node();
+        if (!pivotNode) continue;
+
+        // below: worth it with two or more visible layers under the pivot,
+        // and only when nothing is left "open" at the pivot (it is not
+        // clipped, not inside a masked pass-through group)
+        int belowVisible = 0;
+        bool belowOk = (flags & psPerf::BelowCache) && !psClip::clipFlag(pivotNode.data());
+        for (int i = lvl.begin; i < lvl.pivot && belowOk; i++) {
+            if (!(items[i].m_position & KisMergeWalker::N_BELOW_FILTHY)) belowOk = false;
+            else if (items[i].m_leaf->visible()) belowVisible++;
+        }
+        for (KisNodeSP p = pivotNode->parent(); belowOk && p && p.data() != lvl.level; p = p->parent()) {
+            KisGroupLayer *g = passThroughGroup(p);
+            if (!g) break;
+            if (g->visible() && !passThroughGroupMasks(g).isEmpty()) belowOk = false;
+        }
+        if (belowVisible < 2) belowOk = false;
+
+        // above: the topmost layers, all plain Normal ones
+        int runStart = -1, runVisible = 0;
+        if (flags & psPerf::AboveCache) {
+            for (int i = lvl.end; i > lvl.pivot; i--) {
+                if (!(items[i].m_position & KisMergeWalker::N_ABOVE_FILTHY)) break;
+                if (!psRunEligible(items[i].m_leaf, lvl.level)) break;
+                runStart = i;
+                if (items[i].m_leaf->visible()) runVisible++;
+            }
+        }
+        if (runStart >= 0 && runVisible < 2) runStart = -1;
+
+        if (!belowOk && runStart < 0) continue;
+
+        QVector<const KisNode*> run;
+        for (int i = runStart; runStart >= 0 && i <= lvl.end; i++) {
+            run.append(items[i].m_leaf->node().data());
+        }
+
+        QMutexLocker l(&store->lock);
+        PsCacheEntrySP entry;
+        for (int i = store->entries.size() - 1; i >= 0; i--) {
+            PsCacheEntrySP e = store->entries[i];
+            KisNodeSP entryPivot = e->pivot;
+            if (!entryPivot) {
+                store->killLocked(i);
+                continue;
+            }
+            if (entryPivot.data() == pivotNode.data() && e->level == lvl.level && e->lod == lod) {
+                if (e->graphSeq != pivotNode->graphSequenceNumber() ||
+                    e->pivotClip != psClip::clipFlag(pivotNode.data())) {
+                    store->killLocked(i);
+                } else {
+                    entry = e;
+                }
+                break;
+            }
+        }
+        if (!entry) {
+            entry.reset(new PsCacheEntry());
+            entry->pivot = pivotNode;
+            entry->level = lvl.level;
+            entry->root = root;
+            entry->lod = lod;
+            entry->graphSeq = pivotNode->graphSequenceNumber();
+            entry->pivotClip = psClip::clipFlag(pivotNode.data());
+            store->entries.append(entry);
+            while (store->entries.size() > PsCacheStore::MaxEntries) {
+                int oldest = 0;
+                for (int i = 1; i < store->entries.size(); i++) {
+                    if (store->entries[i]->lastUse < store->entries[oldest]->lastUse) oldest = i;
+                }
+                store->killLocked(oldest);
+            }
+        }
+        entry->lastUse = ++store->clock;
+        lvl.entry = entry;
+
+        // (a colour space conversion is a full refresh, which drops the
+        // entries; this is only a safety net)
+        const KoColorSpace *levelCs = lvl.level->colorSpace();
+        if (entry->colorSpace && entry->colorSpace != levelCs) {
+            entry->below = nullptr;
+            entry->above = nullptr;
+            entry->belowValid = entry->aboveValid = QRegion();
+            entry->colorSpace = nullptr;
+        }
+
+        const QRegion want(lvl.rect);
+        if (belowOk) {
+            lvl.below = (want - entry->belowValid).isEmpty() && entry->below ? PsLevelPlan::Hit : PsLevelPlan::Fill;
+            if (lvl.below == PsLevelPlan::Hit) lvl.belowDevice = entry->below;
+        }
+        if (runStart >= 0) {
+            if (entry->run != run) {
+                entry->run = run;
+                entry->above = nullptr;
+                entry->aboveValid = QRegion();
+            }
+            lvl.runStart = runStart;
+            lvl.above = (want - entry->aboveValid).isEmpty() && entry->above ? PsLevelPlan::Hit : PsLevelPlan::Fill;
+            if (lvl.above == PsLevelPlan::Hit) lvl.aboveDevice = entry->above;
+        }
+        for (int i = lvl.begin; i <= lvl.end; i++) plan.levelOf[i] = li;
+    }
+    return plan;
+}
+
+/// The device of a cache entry, created on first use (under the lock).
+KisPaintDeviceSP psCacheDevice(const PsCacheEntrySP &entry, bool above, KisPaintDeviceSP prototype)
+{
+    PsCacheStore *store = PsCacheStore::instance();
+    QMutexLocker l(&store->lock);
+    KisPaintDeviceSP &dev = above ? entry->above : entry->below;
+    if (!entry->alive) return nullptr;
+    if (!dev) {
+        dev = new KisPaintDevice(prototype->colorSpace());
+        dev->prepareClone(prototype);
+        entry->colorSpace = prototype->colorSpace();
+    }
+    return dev;
+}
+
+/// Marks an area of the device as filled - unless the entry was dropped or
+/// got a new device meanwhile (a concurrent update).
+void psCacheMarkValid(const PsCacheEntrySP &entry, bool above, KisPaintDeviceSP device, const QRect &rect)
+{
+    PsCacheStore *store = PsCacheStore::instance();
+    QMutexLocker l(&store->lock);
+    if (!entry->alive) return;
+    if ((above ? entry->above : entry->below) != device) return;
+    QRegion &valid = above ? entry->aboveValid : entry->belowValid;
+    valid += rect;
+}
+
 } // namespace
 
 
+/*********************************************************************/
+/*                     psPerf (kis_ps_perf.h)                        */
+/*********************************************************************/
+
+int psPerf::flags()
+{
+    return s_psPerfFlags.load(std::memory_order_relaxed);
+}
+
+void psPerf::setFlags(int flags)
+{
+    if (s_psPerfFlags.exchange(flags & psPerf::AllFlags) != (flags & psPerf::AllFlags)) {
+        dropCaches();
+    }
+}
+
+QString psPerf::stats()
+{
+    PsCacheStats &st = PsCacheStore::instance()->stats;
+    int entries = 0;
+    {
+        QMutexLocker l(&PsCacheStore::instance()->lock);
+        entries = PsCacheStore::instance()->entries.size();
+    }
+    return QString("flags=%1 belowHit=%2 belowFill=%3 aboveHit=%4 aboveFill=%5 dropped=%6 "
+                   "skippedVaries=%7 inconsistent=%8 entries=%9")
+        .arg(flags()).arg(st.belowHit.load()).arg(st.belowFill.load())
+        .arg(st.aboveHit.load()).arg(st.aboveFill.load()).arg(st.dropped.load())
+        .arg(st.skippedVaries.load()).arg(st.inconsistent.load()).arg(entries);
+}
+
+void psPerf::resetStats()
+{
+    PsCacheStats &st = PsCacheStore::instance()->stats;
+    st.belowHit = st.belowFill = st.aboveHit = st.aboveFill = 0;
+    st.dropped = st.skippedVaries = st.inconsistent = 0;
+}
+
+void psPerf::dropCaches()
+{
+    PsCacheStore::instance()->dropAll();
+}
