+/// ps_tools patch: Blend If of the layer (its "Blend If (...)" mask, see
+/// kis_ps_blend_if.h) as PSD blending ranges. Untouched when there is none.
+void psBlendIfToRanges(KisNodeSP node, PSDLayerRecord *record)
+{
+    for (KisNodeSP child = node->firstChild(); child; child = child->nextSibling()) {
+        psBlendIf::Settings s;
+        if (!child->visible() || !child->inherits("KisTransparencyMask") ||
+            !psBlendIf::parse(child->name(), s) || !s.active()) {
+            continue;
+        }
+        typedef PSDLayerRecord::LayerBlendingRanges::LayerBlendingRange Range;
+        auto range = [](const psBlendIf::Range &r) {
+            Range out;
+            out.blackValues = {{quint8(r.b0), quint8(r.b1)}};
+            out.whiteValues = {{quint8(r.w0), quint8(r.w1)}};
+            return out;
+        };
+        const QPair<Range, Range> neutral(Range(), Range());
+        const QPair<Range, Range> used(range(s.self), range(s.under));
+        record->blendingRanges.compositeGrayRange = s.channel == 0 ? used : neutral;
+        record->blendingRanges.sourceDestinationRanges.clear();
+        for (int c = 1; c <= 4; c++) {                 // red, green, blue (+1 like Photoshop)
+            record->blendingRanges.sourceDestinationRanges << (s.channel == c ? used : neutral);
+        }
+        return;
+    }
+}
