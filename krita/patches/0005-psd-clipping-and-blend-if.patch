+        // ps_tools patch: Photoshop clipping masks ("inherit alpha" is a
+        // clipping mask in Krita PS, see kis_ps_clipping.h) and Blend If
+        // (blending ranges -> a "Blend If (...)" mask, see kis_ps_blend_if.h)
+        if (newLayer) {
+            if (layerRecord->clipping) {
+                newLayer->disableAlphaChannel(true);
+            }
+            typedef PSDLayerRecord::LayerBlendingRanges::LayerBlendingRange Range;
+            auto neutral = [](const Range &r) {
+                return r.blackValues[0] == 0 && r.blackValues[1] == 0 &&
+                       r.whiteValues[0] == 255 && r.whiteValues[1] == 255;
+            };
+            const PSDLayerRecord::LayerBlendingRanges &br = layerRecord->blendingRanges;
+            QPair<Range, Range> used;
+            QString channel;
+            if (!neutral(br.compositeGrayRange.first) || !neutral(br.compositeGrayRange.second)) {
+                channel = "Gray";
+                used = br.compositeGrayRange;
+            } else {
+                const char *names[3] = {"Red", "Green", "Blue"};
+                for (int c = 0; c < 3 && c < br.sourceDestinationRanges.size(); c++) {
+                    const QPair<Range, Range> &pair = br.sourceDestinationRanges[c];
+                    if (!neutral(pair.first) || !neutral(pair.second)) {
+                        channel = names[c];
+                        used = pair;
+                        break;
+                    }
+                }
+            }
+            if (!channel.isEmpty()) {
+                auto text = [](const Range &r) {
+                    const int b0 = r.blackValues[0], b1 = qMax(b0, int(r.blackValues[1]));
+                    const int w0 = r.whiteValues[0], w1 = qMax(w0, int(r.whiteValues[1]));
+                    return QString("%1/%2 %3/%4").arg(b0).arg(b1).arg(w0).arg(w1);
+                };
+                const QString name = QString("Blend If (%1 | %2 | %3)").arg(channel, text(used.first), text(used.second));
+                psBlendIf::Settings check;
+                if (psBlendIf::parse(name, check) && check.active()) {
+                    KisTransparencyMaskSP mask = new KisTransparencyMask(m_image, name);
+                    mask->initSelection(newLayer);
+                    mask->selection()->pixelSelection()->select(m_image->bounds(), MAX_SELECTED);
+                    m_image->addNode(mask, newLayer);
+                    if (newLayer->compositeOpId() == COMPOSITE_COPY) {
+                        newLayer->setCompositeOpId(COMPOSITE_OVER);
+                    }
+                }
+            }
+        }
