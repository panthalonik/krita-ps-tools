diff --git a/libs/psd/psd_ps_adjustments.h b/libs/psd/psd_ps_adjustments.h
new file mode 100644
index 0000000..0114689
--- /dev/null
+++ b/libs/psd/psd_ps_adjustments.h
@@ -0,0 +1,498 @@
+/*
+ *  Photoshop adjustment layers in PSD files (ps_tools patch).
+ *
+ *  A Krita adjustment (filter) layer is written as a real Photoshop
+ *  adjustment layer when its filter has a Photoshop counterpart: the layer
+ *  record carries no pixels, only the adjustment's own data block ('levl',
+ *  'curv', 'hue2', ...). The formats follow Adobe's PSD specification (the
+ *  same layout Photoshop writes, see e.g. ag-psd's additionalInfo.ts).
+ *
+ *  The values come from the Krita filter configuration. When the ps_tools
+ *  plugin made the layer, its own record (document annotation
+ *  "ps_tools_adjustments") tells which Photoshop adjustment it was, e.g.
+ *  Exposure, which Krita renders with a curve.
+ *
+ *  Filters without a Photoshop counterpart (Color Lookup, Gradient Map,
+ *  Clarity, Grain, ...) are not handled here: they stay pixel layers.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef PSD_PS_ADJUSTMENTS_H
+#define PSD_PS_ADJUSTMENTS_H
+
+#include <algorithm>
+#include <cmath>
+
+#include <QByteArray>
+#include <QDataStream>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QPointF>
+#include <QString>
+#include <QStringList>
+#include <QVector>
+
+#include <QJsonValue>
+
+#include <KisGlobalResourcesInterface.h>
+#include <kis_adjustment_layer.h>
+#include <kis_annotation.h>
+#include <kis_image.h>
+#include <filter/kis_filter.h>
+#include <filter/kis_filter_configuration.h>
+#include <filter/kis_filter_registry.h>
+
+namespace psAdjust {
+
+struct Block {
+    QByteArray key;         // 4 characters
+    QByteArray data;        // big endian
+    int align = 2;          // the block length is padded to this
+};
+
+inline int clampi(double v, int lo, int hi)
+{
+    const int i = int(std::lround(v));
+    return i < lo ? lo : (i > hi ? hi : i);
+}
+
+/// "x,y;x,y;" (Krita's curve text) -> points (0..1)
+inline QVector<QPointF> parseCurve(const QString &text)
+{
+    QVector<QPointF> pts;
+    const QStringList parts = text.split(';', Qt::SkipEmptyParts);
+    for (const QString &p : parts) {
+        const QStringList xy = p.split(',');
+        if (xy.size() < 2) continue;
+        bool okx = false, oky = false;
+        const double x = xy[0].toDouble(&okx), y = xy[1].toDouble(&oky);
+        if (okx && oky) pts << QPointF(x, y);
+    }
+    return pts;
+}
+
+inline bool isIdentityCurve(const QVector<QPointF> &pts)
+{
+    if (pts.size() < 2) return true;
+    for (const QPointF &p : pts) {
+        if (std::fabs(p.x() - p.y()) > 1e-4) return false;
+    }
+    return true;
+}
+
+/// the plugin's record of the layer: {"kind": ..., "params": {...}} or empty
+inline QJsonObject pluginRecord(const KisNode *node)
+{
+    KisImageSP image = node->image().toStrongRef();
+    if (!image) return QJsonObject();
+    KisAnnotationSP a = image->annotation("ps_tools_adjustments");
+    if (!a) return QJsonObject();
+    const QJsonObject store = QJsonDocument::fromJson(a->annotation()).object();
+    return store.value(node->uuid().toString()).toObject();
+}
+
+inline void writeLevelsRecord(QDataStream &s, double ib, double iw, double g, double ob, double ow)
+{
+    const int inLo = clampi(ib * 255.0, 0, 253);
+    const int inHi = clampi(iw * 255.0, inLo + 2, 255);
+    s << qint16(inLo) << qint16(inHi)
+      << qint16(clampi(ob * 255.0, 0, 255)) << qint16(clampi(ow * 255.0, 0, 255))
+      << qint16(clampi(g * 100.0, 10, 999));
+}
+
+inline bool parseLevels(const QString &text, double v[5])
+{
+    const QStringList p = text.split(';');
+    if (p.size() < 5) return false;
+    for (int i = 0; i < 5; i++) {
+        bool ok = false;
+        v[i] = p[i].toDouble(&ok);
+        if (!ok) return false;
+    }
+    return true;
+}
+
+inline void levels(const KisFilterConfigurationSP &cfg, Block &out)
+{
+    out.key = "levl";
+    out.align = 4;
+    QDataStream s(&out.data, QIODevice::WriteOnly);
+    s << quint16(2);
+    double rec[4][5];
+    bool have[4] = {false, false, false, false};
+    if (cfg->getString("mode") == "lightness") {
+        have[0] = parseLevels(cfg->getString("lightness"), rec[0]);
+    } else {
+        for (int i = 0; i < 4; i++) {
+            have[i] = parseLevels(cfg->getString(QString("channel_%1").arg(i)), rec[i]);
+        }
+    }
+    for (int i = 0; i < 29; i++) {
+        if (i < 4 && have[i]) writeLevelsRecord(s, rec[i][0], rec[i][1], rec[i][2], rec[i][3], rec[i][4]);
+        else writeLevelsRecord(s, 0.0, 1.0, 1.0, 0.0, 1.0);
+    }
+    s.writeRawData("Lvls", 4);
+    s << quint16(3) << quint16(62);
+    for (int i = 29; i < 62; i++) writeLevelsRecord(s, 0.0, 1.0, 1.0, 0.0, 1.0);
+}
+
+inline void curves(const KisFilterConfigurationSP &cfg, Block &out)
+{
+    out.key = "curv";
+    out.align = 4;
+    // Krita's channels: 0 = all (composite), 1..3 = red, green, blue - the
+    // same indices Photoshop uses
+    QVector<QVector<QPair<int, int>>> used(4);
+    quint32 mask = 0;
+    for (int i = 0; i < 4; i++) {
+        const QVector<QPointF> pts = parseCurve(cfg->getString(QString("curve%1").arg(i)));
+        if (isIdentityCurve(pts)) continue;
+        int lastIn = -1;
+        for (const QPointF &p : pts) {
+            const int in = clampi(p.x() * 255.0, 0, 255);
+            if (in <= lastIn) continue;                 // Photoshop needs rising inputs
+            used[i] << qMakePair(clampi(p.y() * 255.0, 0, 255), in);
+            lastIn = in;
+        }
+        if (used[i].size() >= 2) mask |= (1u << i);
+        else used[i].clear();
+    }
+    QDataStream s(&out.data, QIODevice::WriteOnly);
+    s << quint8(0) << quint16(1) << mask;
+    auto channel = [&](int i) {
+        s << quint16(used[i].size());
+        for (const auto &pt : used[i]) s << qint16(pt.first) << qint16(pt.second);   // output, input
+    };
+    int count = 0;
+    for (int i = 0; i < 4; i++) {
+        if (mask & (1u << i)) { channel(i); count++; }
+    }
+    s.writeRawData("Crv ", 4);
+    s << quint16(4) << quint32(count);
+    for (int i = 0; i < 4; i++) {
+        if (mask & (1u << i)) { s << quint16(i); channel(i); }
+    }
+}
+
+inline void exposure(const QJsonObject &params, Block &out)
+{
+    out.key = "expA";
+    QDataStream s(&out.data, QIODevice::WriteOnly);
+    s.setFloatingPointPrecision(QDataStream::SinglePrecision);
+    s << quint16(1) << float(params.value("exposure").toDouble(0.0))
+      << float(params.value("offset").toDouble(0.0)) << float(params.value("gamma").toDouble(1.0));
+    s << quint16(0);
+}
+
+inline void hueSaturation(int hue, int sat, int light, bool colorize, Block &out)
+{
+    out.key = "hue2";
+    QDataStream s(&out.data, QIODevice::WriteOnly);
+    s << quint16(2) << quint8(colorize ? 1 : 0) << quint8(0);
+    if (colorize) {
+        int h = ((hue % 360) + 360) % 360;
+        if (h > 180) h -= 360;
+        s << qint16(h) << qint16(qBound(0, sat, 100)) << qint16(qBound(-100, light, 100));
+        s << qint16(0) << qint16(0) << qint16(0);
+    } else {
+        s << qint16(25) << qint16(25) << qint16(0);                 // Photoshop's colorize defaults
+        s << qint16(qBound(-180, hue, 180)) << qint16(qBound(-100, sat, 100))
+          << qint16(qBound(-100, light, 100));
+    }
+    // the six colour ranges with Photoshop's default limits, unchanged
+    const int limits[6][4] = {{315, 345, 15, 45}, {15, 45, 75, 105}, {75, 105, 135, 165},
+                              {135, 165, 195, 225}, {195, 225, 255, 285}, {255, 285, 315, 345}};
+    for (int r = 0; r < 6; r++) {
+        for (int k = 0; k < 4; k++) s << qint16(limits[r][k]);
+        s << qint16(0) << qint16(0) << qint16(0);
+    }
+}
+
+inline void colorBalance(const KisFilterConfigurationSP &cfg, Block &out)
+{
+    out.key = "blnc";
+    QDataStream s(&out.data, QIODevice::WriteOnly);
+    const char *tones[3] = {"shadows", "midtones", "highlights"};
+    for (const char *t : tones) {
+        s << qint16(qBound(-100, cfg->getInt(QString("cyan_red_") + t, 0), 100))
+          << qint16(qBound(-100, cfg->getInt(QString("magenta_green_") + t, 0), 100))
+          << qint16(qBound(-100, cfg->getInt(QString("yellow_blue_") + t, 0), 100));
+    }
+    s << quint8(cfg->getBool("preserve_luminosity", true) ? 1 : 0) << quint8(0);
+}
+
+inline void selectiveColor(const KisFilterConfigurationSP &cfg, Block &out)
+{
+    out.key = "selc";
+    QDataStream s(&out.data, QIODevice::WriteOnly);
+    s << quint16(1) << quint16(cfg->getBool("relative", true) ? 0 : 1);
+    for (int i = 0; i < 4; i++) s << qint16(0);                    // the unused first record
+    const QStringList v = cfg->getString("values").split(',');
+    for (int i = 0; i < 36; i++) {
+        const double pct = i < v.size() ? v[i].trimmed().toDouble() : 0.0;
+        s << qint16(clampi(pct, -100, 100));
+    }
+}
+
+inline void twoBytes(const char *key, int value, Block &out)
+{
+    out.key = key;
+    QDataStream s(&out.data, QIODevice::WriteOnly);
+    s << quint16(value) << quint16(0);
+}
+
+/// The Photoshop adjustment block for the layer. False: no counterpart.
+inline bool forLayer(const KisNode *node, Block &out)
+{
+    const KisAdjustmentLayer *layer = qobject_cast<const KisAdjustmentLayer *>(node);
+    if (!layer) return false;
+    KisFilterConfigurationSP cfg = layer->filter();
+    if (!cfg) return false;
+    const QString filter = cfg->name();
+    const QJsonObject rec = pluginRecord(node);
+    const QString kind = rec.value("kind").toString();
+
+    if (kind == "exposure") {
+        exposure(rec.value("params").toObject(), out);
+        return true;
+    }
+    if (filter == "levels") {
+        levels(cfg, out);
+        return true;
+    }
+    if (filter == "perchannel") {
+        curves(cfg, out);
+        return true;
+    }
+    if (filter == "hsvadjustment") {
+        hueSaturation(cfg->getInt("h", 0), cfg->getInt("s", 0), cfg->getInt("v", 0),
+                      cfg->getBool("colorize", false), out);
+        return true;
+    }
+    if (filter == "desaturate") {                    // Black & White -> Hue/Saturation -100
+        hueSaturation(0, -100, 0, false, out);
+        return true;
+    }
+    if (filter == "colorbalance") {
+        colorBalance(cfg, out);
+        return true;
+    }
+    if (filter == "psselectivecolor") {
+        selectiveColor(cfg, out);
+        return true;
+    }
+    if (filter == "invert") {
+        out.key = "nvrt";
+        out.data.clear();
+        return true;
+    }
+    if (filter == "posterize") {
+        twoBytes("post", qBound(2, cfg->getInt("steps", 4), 255), out);
+        return true;
+    }
+    if (filter == "threshold") {
+        twoBytes("thrs", qBound(1, cfg->getInt("threshold", 128), 255), out);
+        return true;
+    }
+    return false;
+}
+
+// ===================================================================== import
+// Photoshop adjustment layer -> Krita filter layer with the same settings.
+
+/// Keys of the Photoshop adjustment blocks read back on import.
+inline bool isImportedKey(const QString &key)
+{
+    return key == "levl" || key == "curv" || key == "expA" || key == "hue2" || key == "hue " ||
+           key == "blnc" || key == "selc" || key == "nvrt" || key == "post" || key == "thrs";
+}
+
+inline KisFilterConfigurationSP config(const QString &filterId)
+{
+    KisFilterSP f = KisFilterRegistry::instance()->value(filterId);
+    if (!f) return KisFilterConfigurationSP();
+    return f->factoryConfiguration(KisGlobalResourcesInterface::instance());
+}
+
+inline QString levelsText(double ib, double iw, double g, double ob, double ow)
+{
+    return QString("%1;%2;%3;%4;%5").arg(ib).arg(iw).arg(g).arg(ob).arg(ow);
+}
+
+inline QString curveText(const QVector<QPointF> &pts)
+{
+    QString out;
+    for (const QPointF &p : pts) out += QString("%1,%2;").arg(p.x()).arg(p.y());
+    return out;
+}
+
+/// Photoshop's Exposure (linear light) as Krita curve points.
+inline QVector<QPointF> exposureCurve(double e, double offset, double gamma)
+{
+    auto dec = [](double v) { return v <= 0.04045 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4); };
+    auto enc = [](double v) {
+        if (v <= 0.0) return 0.0;
+        return v <= 0.0031308 ? v * 12.92 : 1.055 * std::pow(v, 1.0 / 2.4) - 0.055;
+    };
+    const double a = std::pow(2.0, e), g = std::max(0.01, gamma);
+    QVector<QPointF> pts;
+    for (int i = 0; i <= 32; i++) {
+        const double x = i / 32.0;
+        double v = std::max(0.0, dec(x) * a + offset);
+        v = std::pow(v, 1.0 / g);
+        pts << QPointF(x, std::min(1.0, std::max(0.0, enc(v))));
+    }
+    return pts;
+}
+
+/// Records which Photoshop adjustment a layer is, the way the ps_tools
+/// plugin does (document annotation "ps_tools_adjustments").
+inline void rememberForPlugin(KisImageSP image, const KisNode *node, const QString &kind, const QJsonObject &params)
+{
+    QJsonObject store;
+    if (KisAnnotationSP a = image->annotation("ps_tools_adjustments")) {
+        store = QJsonDocument::fromJson(a->annotation()).object();
+    }
+    QJsonObject rec;
+    rec["kind"] = kind;
+    rec["params"] = params;
+    store[node->uuid().toString()] = rec;
+    image->addAnnotation(KisAnnotationSP(new KisAnnotation(
+        "ps_tools_adjustments", "PS-style adjustment layer data (ps_tools plugin)",
+        QJsonDocument(store).toJson(QJsonDocument::Compact))));
+}
+
+/// A Krita adjustment layer for the Photoshop block, or null when it cannot
+/// be read (the layer is then loaded as before).
+inline KisAdjustmentLayerSP importLayer(KisImageSP image, const QString &name,
+                                        const QString &key, const QByteArray &data)
+{
+    if (!image || !isImportedKey(key)) return KisAdjustmentLayerSP();
+    QDataStream s(data);
+    s.setByteOrder(QDataStream::BigEndian);
+    KisFilterConfigurationSP cfg;
+    QString pluginKind;
+    QJsonObject pluginParams;
+
+    if (key == "levl") {
+        quint16 version = 0;
+        s >> version;
+        if (version != 2) return KisAdjustmentLayerSP();
+        cfg = config("levels");
+        if (!cfg) return KisAdjustmentLayerSP();
+        cfg->setProperty("mode", "channels");
+        cfg->setProperty("number_of_channels", 8);
+        for (int i = 0; i < 8; i++) {
+            QString text = levelsText(0, 1, 1, 0, 1);
+            if (i < 4) {
+                qint16 inLo, inHi, outLo, outHi, gamma;
+                s >> inLo >> inHi >> outLo >> outHi >> gamma;
+                if (s.status() == QDataStream::Ok) {
+                    text = levelsText(inLo / 255.0, inHi / 255.0, std::max(0.01, gamma / 100.0),
+                                      outLo / 255.0, outHi / 255.0);
+                }
+            }
+            cfg->setProperty(QString("channel_%1").arg(i), text);
+        }
+    } else if (key == "curv") {
+        quint8 isMap = 0;
+        quint16 version = 0;
+        quint32 mask = 0;
+        s >> isMap >> version >> mask;
+        if (isMap || version != 1) return KisAdjustmentLayerSP();     // pencil curves: not supported
+        cfg = config("perchannel");
+        if (!cfg) return KisAdjustmentLayerSP();
+        cfg->setProperty("nTransfers", 8);
+        for (int i = 0; i < 32; i++) {
+            if (!(mask & (1u << i))) continue;
+            quint16 count = 0;
+            s >> count;
+            QVector<QPointF> pts;
+            for (int k = 0; k < count && s.status() == QDataStream::Ok; k++) {
+                qint16 out, in;
+                s >> out >> in;
+                pts << QPointF(in / 255.0, out / 255.0);
+            }
+            if (i < 4 && pts.size() >= 2) cfg->setProperty(QString("curve%1").arg(i), curveText(pts));
+        }
+        pluginKind = "curves";
+    } else if (key == "expA") {
+        quint16 version = 0;
+        float e = 0, offset = 0, gamma = 1;
+        s.setFloatingPointPrecision(QDataStream::SinglePrecision);
+        s >> version >> e >> offset >> gamma;
+        if (version != 1 || s.status() != QDataStream::Ok) return KisAdjustmentLayerSP();
+        cfg = config("perchannel");
+        if (!cfg) return KisAdjustmentLayerSP();
+        cfg->setProperty("nTransfers", 8);
+        cfg->setProperty("curve0", curveText(exposureCurve(e, offset, gamma)));
+        pluginKind = "exposure";
+        pluginParams["exposure"] = double(e);
+        pluginParams["offset"] = double(offset);
+        pluginParams["gamma"] = double(gamma);
+    } else if (key == "hue2" || key == "hue ") {
+        quint16 version = 0;
+        quint8 colorize = 0, pad = 0;
+        qint16 ch, cs, cl, mh, ms, ml;
+        s >> version >> colorize >> pad >> ch >> cs >> cl >> mh >> ms >> ml;
+        if (s.status() != QDataStream::Ok) return KisAdjustmentLayerSP();
+        cfg = config("hsvadjustment");
+        if (!cfg) return KisAdjustmentLayerSP();
+        cfg->setProperty("type", 1);
+        cfg->setProperty("compatibilityMode", false);
+        cfg->setProperty("colorize", bool(colorize));
+        cfg->setProperty("h", int(colorize ? ch : mh));
+        cfg->setProperty("s", int(colorize ? cs : ms));
+        cfg->setProperty("v", int(colorize ? cl : ml));
+    } else if (key == "blnc") {
+        qint16 v[9];
+        quint8 preserve = 1;
+        for (int i = 0; i < 9; i++) s >> v[i];
+        s >> preserve;
+        if (s.status() != QDataStream::Ok) return KisAdjustmentLayerSP();
+        cfg = config("colorbalance");
+        if (!cfg) return KisAdjustmentLayerSP();
+        const char *tones[3] = {"shadows", "midtones", "highlights"};
+        for (int t = 0; t < 3; t++) {
+            cfg->setProperty(QString("cyan_red_") + tones[t], int(v[t * 3 + 0]));
+            cfg->setProperty(QString("magenta_green_") + tones[t], int(v[t * 3 + 1]));
+            cfg->setProperty(QString("yellow_blue_") + tones[t], int(v[t * 3 + 2]));
+        }
+        cfg->setProperty("preserve_luminosity", bool(preserve));
+    } else if (key == "selc") {
+        quint16 version = 0, method = 0;
+        s >> version >> method;
+        qint16 skip;
+        for (int i = 0; i < 4; i++) s >> skip;
+        QStringList values;
+        for (int i = 0; i < 36; i++) {
+            qint16 v = 0;
+            s >> v;
+            values << QString::number(int(v));
+        }
+        if (s.status() != QDataStream::Ok) return KisAdjustmentLayerSP();
+        cfg = config("psselectivecolor");
+        if (!cfg) return KisAdjustmentLayerSP();
+        cfg->setProperty("values", values.join(","));
+        cfg->setProperty("relative", method == 0);
+    } else if (key == "nvrt") {
+        cfg = config("invert");
+    } else if (key == "post" || key == "thrs") {
+        quint16 v = 0;
+        s >> v;
+        cfg = config(key == "post" ? "posterize" : "threshold");
+        if (cfg) cfg->setProperty(key == "post" ? "steps" : "threshold", int(v));
+    }
+    if (!cfg) return KisAdjustmentLayerSP();
+
+    KisAdjustmentLayerSP layer = new KisAdjustmentLayer(image, name, cfg->cloneWithResourcesSnapshot(),
+                                                        KisSelectionSP());
+    if (pluginKind == "exposure") {
+        rememberForPlugin(image, layer.data(), pluginKind, pluginParams);
+    }
+    return layer;
+}
+
+} // namespace psAdjust
+
+#endif
