+/**
+ * A group drawn isolated even in "Pass Through" mode, like in Photoshop:
+ * it is a clipping base (the layer right above it is clipped) or is
+ * clipped itself.
+ */
+inline bool isolatesGroup(const KisNode *group)
+{
+    if (!group || !group->parent()) return false;
+    if (clipFlag(group)) return true;
+    KisNodeSP up = layerAbove(group);
+    return up && clipFlag(up.data());
+}
+
+/// Re-check the groups whose clipping may change when `node` changed its
+/// clipping switch: the node itself and the layer below it.
+inline void updateGroupsAround(KisNode *node)
+{
+    if (!node) return;
+    if (KisGroupLayer *g = qobject_cast<KisGroupLayer *>(node)) {
+        g->updatePsClipping();
+    }
+    KisNodeSP below = layerBelow(node);
+    if (KisGroupLayer *g = qobject_cast<KisGroupLayer *>(below.data())) {
+        g->updatePsClipping();
+    }
+}
+
+/// Re-check `node` and every group inside it.
+inline void updateGroupsBelow(KisNode *node)
+{
+    if (!node) return;
+    if (KisGroupLayer *g = qobject_cast<KisGroupLayer *>(node)) {
+        g->updatePsClipping();
+    }
+    for (KisNodeSP c = node->firstChild(); c; c = c->nextSibling()) {
+        updateGroupsBelow(c.data());
+    }
+}
+
+/// Re-check every group among the children of `parent` and inside the
+/// node `added` (after layers were added, removed or moved).
+inline void updateGroupsIn(KisNode *parent, KisNode *added = nullptr)
+{
+    if (parent) {
+        for (KisNodeSP c = parent->firstChild(); c; c = c->nextSibling()) {
+            if (KisGroupLayer *g = qobject_cast<KisGroupLayer *>(c.data())) {
+                g->updatePsClipping();
+            }
+        }
+    }
+    updateGroupsBelow(added);
+}
