diff --git a/libs/image/kis_ps_blend_if.h b/libs/image/kis_ps_blend_if.h
new file mode 100644
index 0000000..8bb1c36
--- /dev/null
+++ b/libs/image/kis_ps_blend_if.h
@@ -0,0 +1,294 @@
+/*
+ *  Photoshop "Blend If" in the compositing engine (ps_tools patch).
+ *
+ *  The settings live in the name of a transparency mask of the layer, the
+ *  same text the ps_tools Python plugin has always used, so documents stay
+ *  compatible with the official Krita (where the plugin computes the mask
+ *  pixels itself):
+ *
+ *      Blend If (Gray | b0/b1 w0/w1 | b0/b1 w0/w1)
+ *                       This Layer    Underlying Layer      (levels 0..255)
+ *
+ *  In Krita PS such a mask is only a carrier of the settings: its pixels are
+ *  ignored (KisMask::apply), and the layer's pixels are faded while the layer
+ *  is composited onto what is below it (KisLayerProjectionPlane), from the
+ *  layer's own colour ("This Layer") and the colour of the image right below
+ *  it ("Underlying Layer"), pixel by pixel, exactly like Photoshop. Nothing
+ *  is cached: painting on the layer or anything below it updates live.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef KIS_PS_BLEND_IF_H
+#define KIS_PS_BLEND_IF_H
+
+#include <cstdio>
+
+#include <QByteArray>
+#include <QLatin1String>
+#include <QRect>
+#include <QString>
+#include <QVector>
+#include <QtGlobal>
+
+#include <KoColorModelStandardIds.h>
+#include <KoColorSpace.h>
+
+#include "kis_node.h"
+#include "kis_paint_device.h"
+
+namespace psBlendIf {
+
+/// One "split slider" pair on the 0..255 scale.
+struct Range {
+    float b0 = 0.0f, b1 = 0.0f, w0 = 255.0f, w1 = 255.0f;
+
+    bool neutral() const { return b0 <= 0.0f && b1 <= 0.0f && w0 >= 255.0f && w1 >= 255.0f; }
+
+    /// opacity factor 0..1 for a level v (0..255), the Photoshop trapezoid
+    float factor(float v) const
+    {
+        if (v < b0) return 0.0f;
+        if (v < b1) return (v - b0) / (b1 - b0);
+        if (v <= w0) return 1.0f;
+        if (v <= w1) return (w1 - v) / (w1 - w0);
+        return 0.0f;
+    }
+};
+
+struct Settings {
+    int channel = 0;            // 0 gray, 1 red, 2 green, 3 blue
+    Range self;                 // "This Layer"
+    Range under;                // "Underlying Layer"
+
+    bool active() const { return !(self.neutral() && under.neutral()); }
+};
+
+inline bool hasPrefix(const QString &name)
+{
+    return name.startsWith(QLatin1String("Blend If ("));
+}
+
+/// Parses the mask name. False when it is not a Blend If mask name.
+inline bool parse(const QString &name, Settings &s)
+{
+    if (!hasPrefix(name)) return false;
+    const QByteArray text = name.toLatin1();
+    char channel[16] = {0};
+    int v[8];
+    const int n = std::sscanf(text.constData(),
+                              "Blend If (%15[A-Za-z] | %d/%d %d/%d | %d/%d %d/%d)",
+                              channel, &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7]);
+    if (n != 9) return false;
+    const QLatin1String c(channel);
+    if (c == QLatin1String("Gray")) s.channel = 0;
+    else if (c == QLatin1String("Red")) s.channel = 1;
+    else if (c == QLatin1String("Green")) s.channel = 2;
+    else if (c == QLatin1String("Blue")) s.channel = 3;
+    else return false;
+    for (int i = 0; i < 8; i++) v[i] = qBound(0, v[i], 255);
+    Range *ranges[2] = {&s.self, &s.under};
+    for (int k = 0; k < 2; k++) {
+        Range &r = *ranges[k];
+        r.b0 = float(v[k * 4 + 0]);
+        r.b1 = float(qMax(v[k * 4 + 0], v[k * 4 + 1]));
+        r.w0 = float(v[k * 4 + 2]);
+        r.w1 = float(qMax(v[k * 4 + 2], v[k * 4 + 3]));
+    }
+    return true;
+}
+
+/// A transparency mask whose name holds Blend If settings (even neutral ones).
+inline bool isSettingsMask(const KisNode *node)
+{
+    if (!node || !node->inherits("KisTransparencyMask")) return false;
+    Settings s;
+    return parse(node->name(), s);
+}
+
+/// The settings of the first visible Blend If mask of the layer. False when
+/// there is none, or when it changes nothing.
+inline bool findSettings(const KisNode *layer, Settings &s)
+{
+    if (!layer) return false;
+    for (KisNodeSP child = layer->firstChild(); child; child = child->nextSibling()) {
+        if (!child->visible() || !child->inherits("KisTransparencyMask")) continue;
+        if (parse(child->name(), s)) return s.active();
+    }
+    return false;
+}
+
+/// Normalised R, G, B of nPixels pixels (3 floats per pixel).
+inline void readRgb(const KoColorSpace *cs, const quint8 *pixels, int nPixels,
+                    float *rgb, QVector<quint8> &scratch)
+{
+    if (cs->colorModelId() == RGBAColorModelID) {
+        const KoID depth = cs->colorDepthId();
+        if (depth == Integer8BitsColorDepthID && cs->pixelSize() == 4) {      // B G R A
+            for (int i = 0; i < nPixels; i++, pixels += 4, rgb += 3) {
+                rgb[0] = pixels[2] / 255.0f;
+                rgb[1] = pixels[1] / 255.0f;
+                rgb[2] = pixels[0] / 255.0f;
+            }
+            return;
+        }
+        if (depth == Integer16BitsColorDepthID && cs->pixelSize() == 8) {     // B G R A
+            const quint16 *p = reinterpret_cast<const quint16 *>(pixels);
+            for (int i = 0; i < nPixels; i++, p += 4, rgb += 3) {
+                rgb[0] = p[2] / 65535.0f;
+                rgb[1] = p[1] / 65535.0f;
+                rgb[2] = p[0] / 65535.0f;
+            }
+            return;
+        }
+        if (depth == Float32BitsColorDepthID && cs->pixelSize() == 16) {      // R G B A
+            const float *p = reinterpret_cast<const float *>(pixels);
+            for (int i = 0; i < nPixels; i++, p += 4, rgb += 3) {
+                rgb[0] = p[0];
+                rgb[1] = p[1];
+                rgb[2] = p[2];
+            }
+            return;
+        }
+    }
+    // anything else (16-bit float, grayscale, CMYK, Lab...): through 16-bit RGBA
+    scratch.resize(nPixels * 8);
+    cs->toRgbA16(pixels, scratch.data(), quint32(nPixels));
+    const quint16 *p = reinterpret_cast<const quint16 *>(scratch.constData());
+    for (int i = 0; i < nPixels; i++, p += 4, rgb += 3) {
+        rgb[0] = p[2] / 65535.0f;
+        rgb[1] = p[1] / 65535.0f;
+        rgb[2] = p[0] / 65535.0f;
+    }
+}
+
+/// The level 0..255 the sliders look at.
+inline float level(int channel, const float *rgb)
+{
+    float v;
+    switch (channel) {
+    case 1: v = rgb[0]; break;
+    case 2: v = rgb[1]; break;
+    case 3: v = rgb[2]; break;
+    default: v = 0.30f * rgb[0] + 0.59f * rgb[1] + 0.11f * rgb[2];
+    }
+    return (v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v)) * 255.0f;
+}
+
+/// Fades the alpha of `layer` (a private copy of the layer's projection) in
+/// `rect` by the Blend If settings; `below` is what the layer is composited
+/// onto, in the same coordinates.
+/// 8 / 16 bit RGBA (B G R A): byte offset of the high byte of channel c
+/// and the pixel size, or false for other colour spaces
+inline bool integerLayout(const KoColorSpace *cs, int &pixelSize, int &step)
+{
+    if (cs->colorModelId() != RGBAColorModelID) return false;
+    const KoID depth = cs->colorDepthId();
+    if (depth == Integer8BitsColorDepthID && cs->pixelSize() == 4) {
+        pixelSize = 4; step = 1; return true;
+    }
+    if (depth == Integer16BitsColorDepthID && cs->pixelSize() == 8) {
+        pixelSize = 8; step = 2; return true;       // little endian: high byte = +1
+    }
+    return false;
+}
+
+/// The level 0..255 of an integer B G R A pixel (high bytes), the same
+/// weights as level() (0.30 / 0.59 / 0.11 in 1/256 steps)
+inline int integerLevel(int channel, const quint8 *px, int step)
+{
+    const int hi = step - 1;
+    const int b = px[0 * step + hi], g = px[1 * step + hi], r = px[2 * step + hi];
+    switch (channel) {
+    case 1: return r;
+    case 2: return g;
+    case 3: return b;
+    default: return (77 * r + 151 * g + 28 * b + 128) >> 8;
+    }
+}
+
+inline void apply(const Settings &s, KisPaintDeviceSP layer, KisPaintDeviceSP below, const QRect &rect)
+{
+    if (rect.isEmpty() || !layer) return;
+    const bool useSelf = !s.self.neutral();
+    const bool useUnder = !s.under.neutral() && below;
+    if (!useSelf && !useUnder) return;
+
+    // fast path: 8 / 16 bit RGBA - a 256 entry table per slider pair
+    int lpx = 0, lstep = 0, bpx = 0, bstep = 0;
+    if (integerLayout(layer->colorSpace(), lpx, lstep) &&
+        (!useUnder || integerLayout(below->colorSpace(), bpx, bstep))) {
+        float selfLut[256], underLut[256];
+        for (int v = 0; v < 256; v++) {
+            selfLut[v] = s.self.factor(float(v));
+            underLut[v] = s.under.factor(float(v));
+        }
+        const KoColorSpace *lcs = layer->colorSpace();
+        const int w = rect.width();
+        const int stripHeight = qBound(1, 65536 / qMax(1, w), rect.height());
+        QVector<quint8> lbuf, bbuf;
+        QVector<float> factor;
+        for (int y = rect.top(); y <= rect.bottom(); y += stripHeight) {
+            const int h = qMin(stripHeight, rect.bottom() - y + 1);
+            const int n = w * h;
+            lbuf.resize(n * lpx);
+            layer->readBytes(lbuf.data(), rect.left(), y, w, h);
+            if (useUnder) {
+                bbuf.resize(n * bpx);
+                below->readBytes(bbuf.data(), rect.left(), y, w, h);
+            }
+            factor.resize(n);
+            bool changes = false;
+            const quint8 *lp = lbuf.constData();
+            const quint8 *bp = bbuf.constData();
+            float *f = factor.data();
+            for (int i = 0; i < n; i++, lp += lpx, bp += bpx) {
+                float v = useSelf ? selfLut[integerLevel(s.channel, lp, lstep)] : 1.0f;
+                if (useUnder) v *= underLut[integerLevel(s.channel, bp, bstep)];
+                f[i] = v;
+                changes = changes || v < 1.0f;
+            }
+            if (!changes) continue;
+            lcs->applyAlphaNormedFloatMask(lbuf.data(), factor.constData(), n);
+            layer->writeBytes(lbuf.constData(), rect.left(), y, w, h);
+        }
+        return;
+    }
+
+    const KoColorSpace *lcs = layer->colorSpace();
+    const KoColorSpace *bcs = useUnder ? below->colorSpace() : nullptr;
+    const int lps = int(lcs->pixelSize());
+    const int bps = bcs ? int(bcs->pixelSize()) : 0;
+    const int w = rect.width();
+    const int stripHeight = qBound(1, 65536 / qMax(1, w), rect.height());
+
+    QVector<quint8> lbuf, bbuf, scratch;
+    QVector<float> rgb, factor;
+
+    for (int y = rect.top(); y <= rect.bottom(); y += stripHeight) {
+        const int h = qMin(stripHeight, rect.bottom() - y + 1);
+        const int n = w * h;
+        lbuf.resize(n * lps);
+        layer->readBytes(lbuf.data(), rect.left(), y, w, h);
+        factor.fill(1.0f, n);
+        rgb.resize(n * 3);
+        if (useSelf) {
+            readRgb(lcs, lbuf.constData(), n, rgb.data(), scratch);
+            for (int i = 0; i < n; i++) factor[i] *= s.self.factor(level(s.channel, rgb.constData() + i * 3));
+        }
+        if (useUnder) {
+            bbuf.resize(n * bps);
+            below->readBytes(bbuf.data(), rect.left(), y, w, h);
+            readRgb(bcs, bbuf.constData(), n, rgb.data(), scratch);
+            for (int i = 0; i < n; i++) factor[i] *= s.under.factor(level(s.channel, rgb.constData() + i * 3));
+        }
+        bool changes = false;
+        for (int i = 0; i < n && !changes; i++) changes = factor[i] < 1.0f;
+        if (!changes) continue;
+        lcs->applyAlphaNormedFloatMask(lbuf.data(), factor.constData(), n);
+        layer->writeBytes(lbuf.constData(), rect.left(), y, w, h);
+    }
+}
+
+} // namespace psBlendIf
+
+#endif
