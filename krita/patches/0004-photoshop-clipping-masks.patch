diff --git a/libs/image/kis_ps_clipping.h b/libs/image/kis_ps_clipping.h
new file mode 100644
index 0000000..5cb0da0
--- /dev/null
+++ b/libs/image/kis_ps_clipping.h
@@ -0,0 +1,98 @@
+/*
+ *  Photoshop clipping masks (ps_tools patch).
+ *
+ *  In Krita PS the "Inherit Alpha" switch of a layer means what Photoshop's
+ *  "Create Clipping Mask" means: the layer is clipped to the nearest layer
+ *  below it that is not clipped itself (the base, in the same group). The
+ *  base and the layers clipped to it - the clipping stack - are composited
+ *  on their own (KisAsyncMerger::startMerge):
+ *
+ *    - the base is drawn onto an empty device, with its own opacity;
+ *    - every clipped layer is drawn onto that device keeping its alpha
+ *      (Krita's alpha-locked compositing), so it only shows where the base
+ *      is, and a clipped adjustment layer only changes the base;
+ *    - the result is composited onto the image below with the base's
+ *      blending mode ("Blend Clipped Layers as Group", Photoshop's default).
+ *
+ *  No hidden groups: clipping follows the layer order live, like in
+ *  Photoshop (a layer clips to whatever base is below it now).
+ *  A clipped layer with no layer below it is drawn normally. A pass-through
+ *  group cannot be a base or a clipped member of a stack (it has no pixels
+ *  of its own): above such a group Krita's original "inherit alpha" applies.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef KIS_PS_CLIPPING_H
+#define KIS_PS_CLIPPING_H
+
+#include "kis_group_layer.h"
+#include "kis_layer.h"
+#include "kis_node.h"
+
+namespace psClip {
+
+inline bool isPassThroughGroup(const KisNode *node)
+{
+    const KisGroupLayer *group = qobject_cast<const KisGroupLayer *>(node);
+    return group && group->passThroughMode();
+}
+
+/// The layer's clipping switch (Krita: "inherit alpha").
+inline bool clipFlag(const KisNode *node)
+{
+    const KisLayer *layer = qobject_cast<const KisLayer *>(node);
+    return layer && layer->alphaChannelDisabled();
+}
+
+inline KisNodeSP layerBelow(const KisNode *node)
+{
+    for (KisNodeSP s = node->prevSibling(); s; s = s->prevSibling()) {
+        if (s->inherits("KisLayer")) return s;
+    }
+    return KisNodeSP();
+}
+
+inline KisNodeSP layerAbove(const KisNode *node)
+{
+    for (KisNodeSP s = node->nextSibling(); s; s = s->nextSibling()) {
+        if (s->inherits("KisLayer")) return s;
+    }
+    return KisNodeSP();
+}
+
+/// The base a clipped layer is clipped to, or null (not clipped / nothing below).
+inline KisNodeSP baseOf(const KisNode *node)
+{
+    if (!node || !clipFlag(node)) return KisNodeSP();
+    KisNodeSP s = layerBelow(node);
+    while (s && clipFlag(s.data())) {
+        s = layerBelow(s.data());
+    }
+    return s;
+}
+
+/// True for a clipped layer that has a base (= PSD "clipping" flag).
+inline bool isClipped(const KisNode *node)
+{
+    return bool(baseOf(node));
+}
+
+/// A base with at least one layer clipped to it: starts an isolated stack.
+inline bool opensStack(const KisNode *node)
+{
+    if (!node || !node->inherits("KisLayer") || clipFlag(node) || isPassThroughGroup(node)) {
+        return false;
+    }
+    KisNodeSP up = layerAbove(node);
+    return up && clipFlag(up.data()) && !isPassThroughGroup(up.data());
+}
+
+/// A layer drawn inside the stack of `base`.
+inline bool inStackOf(const KisNode *node, const KisNodeSP &base)
+{
+    return node && base && clipFlag(node) && !isPassThroughGroup(node) && baseOf(node) == base;
+}
+
+} // namespace psClip
+
+#endif
