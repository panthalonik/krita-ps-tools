+/*********************************************************************/
+/*              Photoshop clipping masks (ps_tools patch)            */
+/*********************************************************************/
+
+/**
+ * A base layer and the layers clipped to it are composited on their own
+ * (see kis_ps_clipping.h): while the stack is open, the merger's current
+ * projection is a private device; when the stack ends it is composited
+ * onto the real projection with the base's blending mode.
+ */
+struct ClipStack {
+    KisNodeSP base;
+    KisPaintDeviceSP below;         // the real projection of the level
+    KisPaintDeviceSP stack;         // base + clipped layers
+    QRect rect;
+};
+
+void openClipStack(ClipStack &s, KisNodeSP base, const QRect &rect, KisPaintDeviceSP &projection)
+{
+    s.base = base;
+    s.below = projection;
+    s.stack = new KisPaintDevice(projection->colorSpace());
+    s.stack->prepareClone(projection);
+    s.rect = rect;
+    projection = s.stack;
+}
+
+void closeClipStack(ClipStack &s, KisPaintDeviceSP &projection)
+{
+    if (!s.base) return;
+    projection = s.below;
+    // a hidden base hides its stack (an empty stack must not be composited
+    // with modes like Copy or Destination In)
+    if (!s.rect.isEmpty() && s.below && s.base->projectionLeaf()->visible()) {
+        KisPainter gc(s.below);
+        gc.setCompositeOpId(s.base->compositeOpId());   // the base's mode, for the whole stack
+        gc.setOpacityU8(OPACITY_OPAQUE_U8);              // the base's opacity is already in
+        gc.setChannelFlags(s.base->projectionLeaf()->channelFlags());
+        gc.bitBlt(s.rect.topLeft(), s.stack, s.rect);
+    }
+    s = ClipStack();
+}
+
 } // namespace
 
 
