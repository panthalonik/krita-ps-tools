+/**
+ * ps_tools patch: fast path for the common RGB / Grayscale 8 and 16 bit
+ * layers. The generic path calls a std::function and looks every channel up
+ * in a QMap for every pixel, which made opening big PSD files take seconds;
+ * here a whole row is converted with plain pointers and written at once.
+ * The values are exactly the same (missing channels -> unit value).
+ */
+using FastRowFunc = void (*)(const QMap<quint16, QByteArray> &channelBytes,
+                             const QVector<quint16> &order, int srcOffset, int width, quint8 *dst);
+
+template<typename T, psd_byte_order byteOrder>
+void psFastRow(const QMap<quint16, QByteArray> &channelBytes, const QVector<quint16> &order, int srcOffset,
+               int width, quint8 *dst)
+{
+    const int n = order.size();
+    const T unit = KoColorSpaceMathsTraits<T>::unitValue;
+    T *out = reinterpret_cast<T *>(dst);
+    for (int c = 0; c < n; c++) {
+        const auto it = channelBytes.constFind(order[c]);
+        const uchar *src = nullptr;
+        int avail = 0;
+        if (it != channelBytes.constEnd()) {
+            src = reinterpret_cast<const uchar *>(it->constData());
+            avail = int(it->size() / int(sizeof(T))) - srcOffset;
+        }
+        const int count = src ? qBound(0, avail, width) : 0;
+        if (sizeof(T) == 2 && byteOrder == psd_byte_order::psdBigEndian) {
+            for (int x = 0; x < count; x++) {
+                out[x * n + c] = T(qFromBigEndian<quint16>(src + size_t(srcOffset + x) * 2));
+            }
+        } else {
+            for (int x = 0; x < count; x++) {
+                T v;
+                memcpy(&v, src + size_t(srcOffset + x) * sizeof(T), sizeof(T));
+                out[x * n + c] = v;
+            }
+        }
+        for (int x = count; x < width; x++) {
+            out[x * n + c] = unit;
+        }
+    }
+}
