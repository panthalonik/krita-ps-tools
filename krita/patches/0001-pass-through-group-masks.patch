+/*********************************************************************/
+/*            Masks on pass-through groups (ps_tools patch)          */
+/*********************************************************************/
+
+/**
+ * Photoshop: a mask on a pass-through group limits where the group's
+ * layers change the image below it. Krita composites the layers of a
+ * pass-through group straight into the parent's projection and drops the
+ * group's masks. Here the masks are honoured:
+ *
+ *  - right before the first layer of such a group is processed, the part of
+ *    the projection that is about to change is saved ("below");
+ *  - the group's own leaf comes right after its last layer (see
+ *    KisProjectionLeaf::nextSibling()); there the projection ("after") is
+ *    blended back over "below" with the product of the group's visible
+ *    transparency masks: result = below + (after - below) * mask.
+ *
+ * The masks are applied with KisMask::apply(), which also takes the stroke
+ * that is being painted on the mask right now (its temporary target) into
+ * account, so the canvas follows the brush.
+ */
+namespace {
+
+struct PassThroughScope {
+    KisPaintDeviceSP below;
+    QRect rect;
+};
+
+typedef QHash<const KisNode*, PassThroughScope> PassThroughScopes;
+
+KisGroupLayer *passThroughGroup(KisNodeSP node)
+{
+    KisGroupLayer *group = qobject_cast<KisGroupLayer*>(node.data());
+    return group && group->passThroughMode() ? group : nullptr;
+}
+
+QList<KisEffectMaskSP> passThroughGroupMasks(const KisGroupLayer *group)
+{
+    QList<KisEffectMaskSP> masks;
+    for (KisNodeSP child = group->firstChild(); child; child = child->nextSibling()) {
+        KisTransparencyMask *mask = qobject_cast<KisTransparencyMask*>(child.data());
+        if (mask && mask->visible()) {
+            masks.append(KisEffectMaskSP(mask));
+        }
+    }
+    return masks;
+}
+
+/// Before a layer is processed: save "below" for each enclosing masked
+/// pass-through group whose first processed layer this is.
+void openPassThroughScopes(KisNodeSP node, const QRect &rect,
+                           KisPaintDeviceSP projection, PassThroughScopes &scopes)
+{
+    for (KisNodeSP parent = node->parent(); parent; parent = parent->parent()) {
+        KisGroupLayer *group = passThroughGroup(parent);
+        if (!group) break;                       // the end of the flattened level
+        if (scopes.contains(group) || !group->visible()) continue;
+        if (passThroughGroupMasks(group).isEmpty()) continue;
+
+        PassThroughScope scope;
+        scope.below = new KisPaintDevice(projection->colorSpace());
+        scope.below->prepareClone(projection);
+        KisPainter::copyAreaOptimized(rect.topLeft(), projection, scope.below, rect);
+        scope.rect = rect;
+        scopes.insert(group, scope);
+    }
+}
+
+/// At the group's own leaf (after its last layer): blend with the mask.
+void closePassThroughScope(KisNodeSP node, const QRect &rect, KisPaintDeviceSP projection,
+                           PassThroughScopes &scopes, KisRenderPassFlags flags)
+{
+    KisGroupLayer *group = passThroughGroup(node);
+    if (!group) return;
+    PassThroughScopes::iterator it = scopes.find(group);
+    if (it == scopes.end()) return;
+    const PassThroughScope scope = it.value();
+    scopes.erase(it);
+
+    const QRect rc = rect & scope.rect;
+    const QList<KisEffectMaskSP> masks = passThroughGroupMasks(group);
+    if (rc.isEmpty() || masks.isEmpty()) return;
+
+    // the product of the masks, as the alpha of an opaque device
+    KisPaintDeviceSP maskDevice = new KisPaintDevice(projection->colorSpace());
+    maskDevice->prepareClone(projection);
+    maskDevice->fill(rc, KoColor(Qt::white, maskDevice->colorSpace()));
+    Q_FOREACH (const KisEffectMaskSP &mask, masks) {
+        mask->apply(maskDevice, rc, rc, KisNode::N_FILTHY, flags);
+    }
+    KisSelectionSP selection = new KisSelection();
+    selection->pixelSelection()->copyAlphaFrom(maskDevice, rc);
+
+    KisPaintDeviceSP after = new KisPaintDevice(projection->colorSpace());
+    after->prepareClone(projection);
+    KisPainter::copyAreaOptimized(rc.topLeft(), projection, after, rc);
+    KisPainter::copyAreaOptimized(rc.topLeft(), scope.below, projection, rc);
+    KisPainter::copyAreaOptimized(rc.topLeft(), after, projection, rc, selection);
+}
+
+} // namespace
