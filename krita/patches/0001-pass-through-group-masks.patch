+namespace {
+/// ps_tools patch: transparency masks of pass-through groups are rendered
+/// (see KisAsyncMerger), so they are not shown as disabled.
+KisProjectionLeaf::NodeDropReason shownDropReason(KisNodeSP node)
+{
+    KisProjectionLeaf::NodeDropReason reason = node->projectionLeaf()->dropReason();
+    if (reason == KisProjectionLeaf::DropPassThroughMask &&
+        qobject_cast<KisTransparencyMask*>(node.data())) {
+        return KisProjectionLeaf::NodeAvailable;
+    }
+    return reason;
+}
